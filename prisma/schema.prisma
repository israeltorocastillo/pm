generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  ADMIN
  MEMBER
  VIEWER
}

enum ExpertiseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProjectType {
  PREDICTIVO
  AGIL_SCRUM
  HIBRIDO
  MEJORA_LEAN
  MEJORA_SIX_SIGMA
  ANALISIS_NEGOCIO
  BIM
}

enum ProjectStatus {
  IDEA
  EVALUACION
  EN_CURSO
  EN_PAUSA
  CERRADO
  CANCELADO
}

enum CynefinDomain {
  CLARO
  COMPLICADO
  COMPLEJO
  CAOTICO
  DESORDEN
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum TaskStatus {
  POR_HACER
  EN_CURSO
  HECHO
  BLOQUEADO
}

enum ToolStatus {
  BORRADOR
  EN_REVISION
  APROBADO
}

enum AuthorType {
  USER
  AI_ACCEPTED
}

enum ProposalStatus {
  PENDIENTE
  ACEPTADA
  EDITADA
  RECHAZADA
}

model Organization {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  members   Membership[]
  projects  Project[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?
  jobTitle     String?
  expertise    ExpertiseLevel @default(INTERMEDIATE)
  memberships  Membership[]
  projectRoles ProjectMember[]
  createdAt    DateTime     @default(now())
}

model Membership {
  id     String       @id @default(cuid())
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId  String
  role   OrgRole

  @@unique([userId, orgId])
}

model Project {
  id               String        @id @default(cuid())
  org              Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId            String
  name             String
  description      String?
  type             ProjectType
  status           ProjectStatus @default(IDEA)
  objective        String?
  problemStatement String?
  cynefinDomain    CynefinDomain?
  startDate        DateTime?
  endDate          DateTime?
  keyResultId      String?
  members          ProjectMember[]
  tools            ToolInstance[]
  tasks            Task[]
  conversations    AiConversation[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model ProjectMember {
  id         String      @id @default(cuid())
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  role       ProjectRole
  methodRole String?

  @@unique([projectId, userId])
}

model Task {
  id               String     @id @default(cuid())
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String
  title            String
  description      String?
  assigneeId       String?
  dueDate          DateTime?
  status           TaskStatus @default(POR_HACER)
  sourceInstanceId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model ToolInstance {
  id                String        @id @default(cuid())
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  phaseId           String?
  toolId            String
  title             String
  status            ToolStatus    @default(BORRADOR)
  data              Json
  schemaVersion     Int
  derived           Json?
  sourceInstanceId  String?
  createdById       String
  versions          ToolVersion[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model ToolVersion {
  id         String       @id @default(cuid())
  instance   ToolInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId String
  data       Json
  version    Int
  authorId   String
  authorType AuthorType
  createdAt  DateTime     @default(now())

  @@unique([instanceId, version])
}

model AiConversation {
  id        String       @id @default(cuid())
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
  userId    String
  context   Json?
  messages  Json
  proposals AiProposal[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model AiProposal {
  id             String          @id @default(cuid())
  conversation   AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  kind           String
  payload        Json
  status         ProposalStatus  @default(PENDIENTE)
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime        @default(now())
}

model AiUsage {
  id           String   @id @default(cuid())
  orgId        String
  userId       String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())
}
